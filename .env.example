NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/legacy_trivia

JWT_ACCESS_SECRET=replace_with_strong_random_string
JWT_REFRESH_SECRET=replace_with_another_strong_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRY_MINUTES=10
BCRYPT_SALT_ROUNDS=12

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# SMTP — outgoing email transport. If host/user are blank, emails are logged
# to the console in development and the sender throws in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=Pairpel
EMAIL_FROM_ADDRESS=no-reply@pairpel.com

# Brand — used inside email templates (logo, footer, links).
BRAND_NAME=Pairpel
BRAND_LEGAL_NAME=PAIRPEL Games Ltd.
BRAND_ADDRESS=123 Trivia Lane, Game City, Playland
BRAND_INSTAGRAM_URL=https://instagram.com/pairpel
BRAND_DISCORD_URL=https://discord.gg/pairpel
SUPPORT_EMAIL=support@pairpel.com

# Optional — overrides where email images are loaded from. Defaults to
# `${CLIENT_URL}/images` so the frontend's /public/images/ folder is used.
# BRAND_ASSETS_BASE_URL=https://pairpel.com/images

CLIENT_URL=http://localhost:3000
